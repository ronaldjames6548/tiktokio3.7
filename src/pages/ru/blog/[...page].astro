---
export const prerender = true;

import { getCollection } from "astro:content";
import Pagination from "@components/blog/pagination.astro";
import Posts from "@components/blog/posts.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";

export async function getStaticPaths({ paginate }) {
  // Fetch all non-draft posts from the vi content folder.
  // We intentionally do NOT filter by publishDate here — the strict
  // "instanceof Date && <= new Date()" check was silently dropping posts
  // with missing or slightly malformed dates, leaving fewer than 11 posts
  // and causing paginate() to generate only 1 page, so /vi/blog/2 never
  // existed at build time and Vercel returned 404.
  const posts = await getCollection("blog", ({ id, data }) => {
    return id.startsWith("vi/") && !data.draft;
  });

  // Sort newest first
  posts.sort(
    (a, b) =>
      (b.data.publishDate?.valueOf() ?? 0) -
      (a.data.publishDate?.valueOf() ?? 0)
  );

  // paginate() generates /vi/blog/, /vi/blog/2/, /vi/blog/3/ etc.
  // because this file lives at src/pages/vi/blog/[...page].astro
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;

const title = "Blog – Tiktokio TikTok Downloader";
const description =
  "Khám phá các bài viết mới nhất về TikTok, mạng xã hội và công nghệ.";
---

<Layout title={title} description={description}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Blog</Fragment>
      <Fragment slot="desc">
        Khám phá tin tức, hướng dẫn và cập nhật mới nhất.
      </Fragment>
    </Sectionhead>

    <Posts posts={page.data} />

    <!--
      page.url.prev / page.url.next are already locale-prefixed by Astro's
      paginate() — e.g. /vi/blog/ and /vi/blog/2/ — so pagination.astro
      must NOT run getRelativeLocaleUrl() on them again (that caused the
      /vi/vi/blog/2 double-locale bug). Use the fixed pagination.astro that
      renders plain <a> tags with the URLs as-is.
    -->
    <Pagination
      class="mt-20"
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </Container>
</Layout>