---
export const prerender = true;

import { getCollection } from "astro:content";
import Pagination from "@components/blog/pagination.astro";
import Posts from "@components/blog/posts.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";

import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths({ paginate }) {
  try {
    const posts = await getCollection("blog", ({ data }) => {
      return !data.draft && data.publishDate instanceof Date && data.publishDate <= new Date();
    });

    const processedPosts = posts.map((post) => {
      const slugParts = post.slug.split("/");
      let postLang = "en";
      let finalSlug = post.slug;
      if (slugParts.length > 1 && slugParts[0].length === 2) {
        postLang = slugParts[0];
        finalSlug = slugParts.slice(1).join("/");
      }
      return { ...post, slug: finalSlug, lang: postLang };
    });

    // FIX: Fall back to English posts when no ms posts exist.
    // Without this, paginate([]) only builds page 1 — hreflang then sends
    // crawlers to /ms/blog/2/ which was never built → 500 error.
    const localizedPosts = processedPosts.filter((post) => post.lang === "ms");
    const englishPosts   = processedPosts.filter((post) => post.lang === "en");
    const postsToRender  = localizedPosts.length > 0 ? localizedPosts : englishPosts;

    postsToRender.sort(
      (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
    );

    if (postsToRender.length === 0) {
      return [{
        params: { page: undefined },
        props: {
          page: {
            data: [], start: 0, end: -1, total: 0,
            currentPage: 1, size: 10, lastPage: 1,
            url: { current: "/ms/blog", prev: undefined, next: undefined },
          },
        },
      }];
    }

    return paginate(postsToRender, { pageSize: 10 });

  } catch (error) {
    console.error("Error in getStaticPaths [ms/blog/[...page]]:", error);
    return [{
      params: { page: undefined },
      props: {
        page: {
          data: [], start: 0, end: -1, total: 0,
          currentPage: 1, size: 10, lastPage: 1,
          url: { current: "/ms/blog", prev: undefined, next: undefined },
        },
      },
    }];
  }
}

const { page = { data: [], url: { prev: undefined, next: undefined } } } = Astro.props;

const title = 'Blog Posts for Tiktokio - Tiktok Downloader Without Watermark';
const description = 'Find the latest blogs posts for Tiktokio Tiktok Video Downloader, Tech News, Social media updates and more';

const safeUrl = Astro.url || new URL("/", Astro.site || "http://localhost:4321");
const pageLang = getLangFromUrl(safeUrl);
const t = useTranslations(pageLang);
---

<Layout title={title} description={description}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Our Blog</Fragment>
      <Fragment slot="desc">Discover Industry Insights, Company News, and Expert Opinions.</Fragment>
    </Sectionhead>
    <Posts posts={page.data || []} />
    <Pagination class="mt-20" prevUrl={page.url?.prev} nextUrl={page.url?.next} />
  </Container>
</Layout>
