---
export const prerender = true;

import { getCollection } from "astro:content";
import Pagination from "@components/blog/pagination.astro";
import Posts from "@components/blog/posts.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";

import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths({ paginate }) {
	try {
		const allPosts = await getCollection("blog", ({ data }) => {
			return !data.draft && data.publishDate instanceof Date && data.publishDate <= new Date();
		});

		const postsByLang: Record<string, any[]> = {};

		allPosts.forEach((post) => {
			const slugParts = post.slug.split("/");
			const lang = (slugParts[0]?.length === 2) ? slugParts[0] : "en";
			if (!postsByLang[lang]) postsByLang[lang] = [];
			postsByLang[lang].push(post);
		});

		const paths: any[] = [];

		Object.entries(postsByLang).forEach(([lang, posts]) => {
			posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

			if (posts.length === 0) {
				paths.push({
					params: { lang, page: undefined },
					props: { page: { data: [], url: { current: `/${lang}/blog`, prev: undefined, next: undefined } } }
				});
				return;
			}

			const paginated = paginate(posts, {
				pageSize: 10,
				params: { lang },           // Crucial
			});
			paths.push(...paginated);
		});

		return paths;
	} catch (error) {
		console.error("Error in blog pagination:", error);
		return [];
	}
}

const { page } = Astro.props;
const safeUrl = Astro.url || new URL("/", Astro.site || "http://localhost:4321");
const pageLang = getLangFromUrl(safeUrl);
const t = useTranslations(pageLang);

const title = 'Blog Posts for Tiktokio - Tiktok Downloader Without Watermark';
const description = 'Find the latest blogs posts for Tiktokio Tiktok Video Downloader, Tech News, Social media updates and more';
---

<Layout title={title} description={description}>
	<Container>
		<Sectionhead>
			<Fragment slot="title">Our Blog</Fragment>
			<Fragment slot="desc">Discover Industry Insights, Company News, and Expert Opinions.</Fragment>
		</Sectionhead>
		<Posts posts={page?.data || []} />
		<Pagination class="mt-20" prevUrl={page?.url?.prev} nextUrl={page?.url?.next} />
	</Container>
</Layout>