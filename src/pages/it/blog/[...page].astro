---
export const prerender = true;

import { getCollection } from "astro:content";
import Pagination from "@components/blog/pagination.astro";
import Posts from "@components/blog/posts.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";

import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths({ paginate }) {
  try {
    const posts = await getCollection("blog", ({ data }) => {
      return !data.draft && data.publishDate instanceof Date && data.publishDate <= new Date();
    });

    const processedPosts = posts.map((post) => {
      const slugParts = post.slug.split("/");
      let postLang = "en";
      let finalSlug = post.slug;
      if (slugParts.length > 1 && slugParts[0].length === 2) {
        postLang = slugParts[0];
        finalSlug = slugParts.slice(1).join("/");
      }
      return { ...post, slug: finalSlug, lang: postLang };
    });

    // Fall back to English posts when no it posts exist.
    // Prevents paginate([]) from building only page 1 while hreflang
    // sends crawlers to /it/blog/2/ → was never built → 500 error.
    const localizedPosts = processedPosts.filter((post) => post.lang === "it");
    const englishPosts   = processedPosts.filter((post) => post.lang === "en");
    const postsToRender  = localizedPosts.length > 0 ? localizedPosts : englishPosts;

    postsToRender.sort(
      (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
    );

    if (postsToRender.length === 0) {
      return [{
        params: { page: undefined },
        props: {
          page: {
            data: [], start: 0, end: -1, total: 0,
            currentPage: 1, size: 10, lastPage: 1,
            url: { current: "/it/blog", prev: undefined, next: undefined },
          },
        },
      }];
    }

    return paginate(postsToRender, { pageSize: 10 });

  } catch (error) {
    console.error("Error in getStaticPaths [it/blog/[...page]]:", error);
    return [{
      params: { page: undefined },
      props: {
        page: {
          data: [], start: 0, end: -1, total: 0,
          currentPage: 1, size: 10, lastPage: 1,
          url: { current: "/it/blog", prev: undefined, next: undefined },
        },
      },
    }];
  }
}

const { page = { data: [], url: { prev: undefined, next: undefined } } } = Astro.props;

// FIX: Strip the leading /it from pagination URLs before passing to <Pagination>.
//
// Root cause of /ko/ko/ko/blog/3/ triple-prefix:
//   1. paginate() in this file returns page.url.next = '/it/blog/2/'  (1st prefix)
//   2. pagination.astro calls getRelativeLocaleUrl(lang, '/it/blog/2/')
//      which prepends /it again → '/it/it/blog/2/'            (2nd prefix)
//   3. Astro i18n middleware adds /it once more when rendering         (3rd prefix)
//
// Fix: pass '/blog/2/' (no lang prefix) to <Pagination>.
//      getRelativeLocaleUrl(lang, '/blog/2/') → '/it/blog/2/'         (1 prefix ✓)
const stripLang = (url: string | undefined): string | undefined => {
  if (!url) return undefined;
  // Remove one leading /it segment, e.g. '/ko/blog/2/' → '/blog/2/'
  const cleaned = url.replace(/^\/it\//, '/');
  return cleaned || '/';
};

const prevUrl = stripLang(page.url?.prev);
const nextUrl = stripLang(page.url?.next);

const title = 'Blog Posts for Tiktokio - Tiktok Downloader Without Watermark';
const description = 'Find the latest blogs posts for Tiktokio Tiktok Video Downloader, Tech News, Social media updates and more';

const safeUrl = Astro.url || new URL("/", Astro.site || "http://localhost:4321");
const pageLang = getLangFromUrl(safeUrl);
const t = useTranslations(pageLang);
---

<Layout title={title} description={description}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">Our Blog</Fragment>
      <Fragment slot="desc">Discover Industry Insights, Company News, and Expert Opinions.</Fragment>
    </Sectionhead>
    <Posts posts={page.data || []} />
    <Pagination class="mt-20" prevUrl={prevUrl} nextUrl={nextUrl} />
  </Container>
</Layout>
