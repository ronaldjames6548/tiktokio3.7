---
import { moreLinks, moreLinkGroups, moreLinksTitle, moreLinksNote } from "../data/morelinks";

const groups = moreLinkGroups
	.map((name) => ({ name, items: moreLinks.filter((l) => l.group === name) }))
	.filter((g) => g.items.length > 0);
---

{groups.length > 0 && (
	<section class="mx-auto max-w-7xl px-6 py-10 lg:px-8" aria-labelledby="more-links">
		<div class="text-center mb-6">
			<h2 id="more-links" class="text-2xl md:text-3xl font-bold text-gray-900">{moreLinksTitle}</h2>
			<div class="w-24 h-1 mx-auto bg-orange-400 mt-2"></div>
			<p class="mt-3 text-sm text-gray-600">{moreLinksNote}</p>
		</div>
		{groups.map((g) => (
			<div class="mb-6">
				<h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-gray-600">{g.name}</h3>
				<div class="flex flex-wrap gap-2">
					{g.items.map((l) => (
						<a
							href={l.url}
							target="_blank"
							rel="sponsored nofollow noopener noreferrer"
							class="inline-block rounded-full border border-gray-300 bg-gray-100 px-3 py-1 text-sm text-gray-900 no-underline hover:border-orange-400"
						>{l.label}</a>
					))}
				</div>
			</div>
		))}
	</section>
)}
