---
import InputScreen from "./InputScreen";
import { useTranslations } from "../i18n/utils";

// English homepage hero (uses home.* keys so other pages are not affected)
const t = useTranslations("en");
---
<div class="relative isolate pt-14 bg-amber-600">
<div class="sm:pt-10">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-6xl text-center">
      <h1 class="text-2xl font-bold tracking-tight text-black sm:text-4xl">{t("home.main.hero.title")}</h1>
      <p class="mt-2 text-lg leading-8 text-gray-900">{t("home.main.hero.subtitle")}</p>
      <InputScreen client:only="solid-js" />
      <!-- Native banner ad: fixed 300px box centered on the page; the ad fills this box -->
      <div class="hero-ad mx-auto mt-6 w-[300px] max-w-full min-h-[250px] overflow-hidden">
        <script data-cfasync="false" async type="text/javascript" src="//qv.ithielalture.com/tGMBKSaX8hetVBRXw/161737"></script>
      </div>
    </div>
  </div>
</div>
</div>

<style is:global>
  /* Force whatever the ad script injects to sit centered inside its 300px box */
  .hero-ad { text-align: center; }
  .hero-ad > *,
  .hero-ad > div > * {
    float: none !important;
    margin-left: auto !important;
    margin-right: auto !important;
    max-width: 100% !important;
  }
  .hero-ad iframe,
  .hero-ad ins,
  .hero-ad img { display: block; }
</style>