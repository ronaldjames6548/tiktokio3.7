---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";

const {
  prevUrl,
  nextUrl,
  prevText = "blog.prev",
  nextText = "blog.next",
  class: className,
} = Astro.props;

const safeUrl = Astro.url || new URL("/", Astro.site || "http://localhost:4321");
const lang = getLangFromUrl(safeUrl);
const t = useTranslations(lang);

// DO NOT call getRelativeLocaleUrl() here.
// Astro's paginate() already returns locale-prefixed URLs
// (e.g. /vi/blog/2/) because the page file lives under src/pages/vi/.
// Passing those through getRelativeLocaleUrl('vi', '/vi/blog/2/')
// would add the prefix a second time → /vi/vi/blog/2/.
// Using plain <a> tags with the URL as-is is the correct approach.
---

{
  (prevUrl || nextUrl) && (
    <div class:list={["container flex", className]}>
      <div class="flex flex-row mx-auto container justify-center gap-8">
        {prevUrl && (
          <a
            href={prevUrl}
            class="flex items-center gap-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
          >
            <Icon name="ion:arrow-back" class="w-6 h-6" />
            <span>{t(prevText)}</span>
          </a>
        )}

        {nextUrl && (
          <a
            href={nextUrl}
            class="flex items-center gap-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
          >
            <span>{t(nextText)}</span>
            <Icon name="ion:arrow-forward" class="w-6 h-6" />
          </a>
        )}
      </div>
    </div>
  )
}