---
import Link from "@components/ui/link.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";

export interface Props {
	prevUrl: string;
	nextUrl: string;
	prevText?: string;
	nextText?: string;
	class?: string;
}

const {
	prevUrl,
	nextUrl,
	prevText = "blog.prev",
	nextText = "blog.next",
	class: className,
} = Astro.props;

const safeUrl = Astro.url || new URL('/', Astro.site || 'http://localhost:4321');
const lang = getLangFromUrl(safeUrl);
const t = useTranslations(lang);

// FIX: Removed localizePath() / getRelativeLocaleUrl() entirely.
//
// Root cause of /id/id/blog/2/ double-prefix:
//   - page.url.next from Astro's paginate() already returns the fully-prefixed
//     path e.g. '/id/blog/2/' — it is correct and ready to use as-is.
//   - The old localizePath() called getRelativeLocaleUrl(lang, '/id/blog/2/')
//     which blindly prepended /id/ again → '/id/id/blog/2/'
//   - Astro i18n middleware then added a third /id/ → '/id/id/id/blog/2/'
//
// Fix: use prevUrl and nextUrl directly as href values. No transformation needed.
---

{
	(prevUrl || nextUrl) && (
		<div class:list={["container flex", className]}>
			<div class="flex flex-row mx-auto container justify-center gap-8">
				<Link href={prevUrl} style="muted" class={`${!prevUrl ? "invisible" : ""}`}>
					<div class="flex flex-row align-middle">
						<Icon name="ion:arrow-back" class="w-6 h-6" />
						<p class="ml-2">{t(prevText)}</p>
					</div>
				</Link>
				<Link href={nextUrl} style="muted" class={`${!nextUrl ? "invisible" : ""}`}>
					<div class="flex flex-row align-middle">
						<span class="mr-2">{t(nextText)}</span>
						<Icon name="ion:arrow-back" class="w-6 h-6" />
					</div>
				</Link>
			</div>
		</div>
	)
}